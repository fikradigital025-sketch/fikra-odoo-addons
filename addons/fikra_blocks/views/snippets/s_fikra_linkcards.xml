<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================================
         Cartes-liens
         Six cartes en deux lignes de trois. Au survol : le texte descriptif
         monte depuis le bas. Au clic : la page liée s'ouvre.

         Toute la carte est un <a> : la zone cliquable couvre l'image entière,
         pas seulement le titre. C'est plus facile à viser, surtout au doigt.

         Pour changer une destination : sélectionner la carte dans l'éditeur
         et modifier le lien, comme pour n'importe quel lien Odoo.
         ==================================================================== -->
    <template id="s_fikra_linkcards" name="Cartes-liens">
