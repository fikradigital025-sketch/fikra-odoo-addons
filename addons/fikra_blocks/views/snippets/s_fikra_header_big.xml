<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================================
         Fikra header template - "Navbar BIG"
         A real Odoo header (inherits website.layout): it replaces the native
         header on every page and follows the header scroll effects.

         Layout (desktop, measurements from big.dk at ~1520px):
           - left   : the site logo. A click turns it into 3 bars as wide as
                      the widest page label, and drops a vertical page list
                      below them (static list, edited inline in the editor).
           - centre : the main menu (Odoo menu manager), uppercase 13px,
                      items 105px apart. An item that has sub-menus in the
                      menu manager opens a horizontal row of sub-pages under
                      the menu (13px, 40px apart). Remove the sub-menus in the
                      menu manager and the row disappears for that item.
           - right  : search, 145px after the last item: magnifier + rotating
                      suggestions (edited inline), real search on submit.
         Mobile (< 992px): Odoo's native mobile header, which already lists
         the menu and its sub-menus.

         Main menu and sub-menus: Site > Menus (or "Modifier le menu").
         ==================================================================== -->
    <template id="template_header_fikra_big" inherit_id="website.layout"
              name="Template Header Fikra BIG" active="False">
        <xpath expr="//header//nav" position="replace">
            <t t-call="website.navbar">
                <t t-set="_navbar_classes" t-valuef="d-none d-lg-block s_fikra_bn"/>

                <div id="o_main_nav" class="o_main_nav s_fikra_bn_bar">

                    <!-- Left: logo, turns into 3 bars + vertical page list -->
                    <div class="s_fikra_bn_left">
                        <div class="s_fikra_bn_brand" role="button" tabindex="0"
                             aria-expanded="false" aria-label="Menu">
                            <span class="s_fikra_bn_logo">
                                <t t-call="website.placeholder_header_brand">
                                    <t t-set="_link_class" t-valuef="p-0 m-0"/>
                                </t>
                            </span>
                            <span class="s_fikra_bn_bars" aria-hidden="true"><i/><i/><i/></span>
                        </div>
                        <!-- Static list, independent from the main menu:
                             edit each text and link directly in the editor. -->
                        <ul class="s_fikra_bn_list">
                            <li><a href="#">Projets</a></li>
                            <li><a href="#">Produits</a></li>
                            <li><a href="#">Carrière</a></li>
                            <li><a href="#">Équipe</a></li>
                            <li><a href="/blog">Blog</a></li>
                            <li><a href="/contactus">Contact</a></li>
                        </ul>
                    </div>

                    <!-- Centre: main menu + sub-menu rows -->
                    <div class="s_fikra_bn_center">
                        <t t-call="website.navbar_nav">
                            <t t-set="_nav_class" t-valuef="s_fikra_bn_main"/>
                            <t t-set="_no_autohide_menu_mobile" t-valuef="True"/>
                            <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                <t t-set="_fikra_kids" t-value="submenu.child_id.filtered(lambda m: m.is_visible)"/>
                                <li t-if="submenu.is_visible" class="nav-item s_fikra_bn_item" role="presentation">
                                    <a t-att-href="submenu._clean_url()"
                                       t-attf-class="nav-link s_fikra_bn_link #{submenu._is_active() and 'active'}"
                                       t-att-data-fikra-sub="submenu.id if _fikra_kids else None"
                                       t-att-target="'_blank' if submenu.new_window else None"
                                       role="menuitem"
                                       t-ignore="true">
                                        <span t-field="submenu.name"/>
                                    </a>
                                </li>
                            </t>
                        </t>

                        <t t-set="_fikra_open" t-value="website.menu_id.child_id.filtered(lambda m: m.is_visible and m.child_id.filtered(lambda c: c.is_visible) and m._is_active())"/>
                        <div t-attf-class="s_fikra_bn_subs #{_fikra_open and 'has-open'}">
                            <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                <t t-set="_fikra_kids" t-value="submenu.child_id.filtered(lambda m: m.is_visible)"/>
                                <ul t-if="submenu.is_visible and _fikra_kids"
                                    t-attf-class="s_fikra_bn_sub #{submenu._is_active() and 'is-open'}"
                                    t-att-data-fikra-sub="submenu.id"
                                    role="menu">
                                    <li t-foreach="_fikra_kids" t-as="child" role="presentation">
                                        <a t-att-href="child._clean_url()"
                                           t-attf-class="s_fikra_bn_sublink #{child._is_active() and 'active'}"
                                           t-att-target="'_blank' if child.new_window else None"
                                           role="menuitem"
                                           t-ignore="true">
                                            <span t-field="child.name"/>
                                        </a>
                                    </li>
                                </ul>
                            </t>
                        </div>
                    </div>

                    <!-- Right: search with rotating suggestions -->
                    <div class="s_fikra_bn_right">
                        <form action="/website/search" method="get" class="s_fikra_bn_search" role="search">
                            <button type="submit" class="s_fikra_bn_search_btn" aria-label="Rechercher">
                                <i class="fa fa-search"/>
                            </button>
                            <span class="s_fikra_bn_field">
                                <input type="search" name="search" class="s_fikra_bn_input"
                                       autocomplete="off" aria-label="Rechercher"/>
                                <!-- Suggestions shown in turn: edit, add or remove words. -->
                                <span class="s_fikra_bn_hints" aria-hidden="true">
                                    <span>Musée</span>
                                    <span>Niamey</span>
                                    <span>Durabilité</span>
                                    <span>Logement</span>
                                </span>
                            </span>
                        </form>
                    </div>

                </div>
            </t>
            <t t-call="website.template_header_mobile"/>
        </xpath>
    </template>

    <!-- Register the header as a selectable template in the editor
         (Thème > En-tête > Modèle), next to the native ones. -->
    <template id="fikra_header_big_option" inherit_id="website.snippet_options"
              name="Fikra Header BIG - option">
        <xpath expr="//we-button[@data-name='header_sidebar_opt']" position="after">
            <we-button title="Fikra - Navbar BIG"
                       data-name="header_fikra_big_opt"
                       data-trigger="regular_header_visibility_opt"
                       data-customize-website-views="fikra_blocks.template_header_fikra_big, website.no_autohide_menu"
                       data-customize-website-variable="'fikra_big'"
                       data-img="/website/static/src/img/snippets_options/header_template_default.svg"/>
        </xpath>
    </template>

</odoo>
