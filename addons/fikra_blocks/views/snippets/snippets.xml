<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================================
         Enregistrement des blocs Fikra dans le panneau de l'éditeur.

         Odoo 18 exige deux attributs pour qu'un snippet soit visible :
           - string : le libellé affiché
           - group  : la catégorie (intro, columns, content, images,
                      people, text, custom)
         Sans `group`, le bloc est chargé mais n'apparaît nulle part.
         ==================================================================== -->
    <template id="fikra_snippets" inherit_id="website.snippets"
              name="Fikra Blocks — enregistrement">

        <xpath expr="//snippets[@id='snippet_structure']/t[@t-snippet][last()]"
               position="after">

            <t t-snippet="fikra_blocks.s_fikra_portfolio_hero"
               string="Portfolio Hero"
               group="intro">
                <keywords>portfolio, hero, intro, couverture, cover, accueil, banniere, titre</keywords>
            </t>

            <t t-snippet="fikra_blocks.s_fikra_portfolio_bento"
               string="Portfolio Bento"
               group="content">
                <keywords>portfolio, bento, grille, cartes, about, propos, globe, stack, competences</keywords>
            </t>

            <t t-snippet="fikra_blocks.s_fikra_counter"
               string="Compteurs animés"
               group="content">
                <keywords>compteur, chiffres, statistiques, nombres, counter, kpi, animation</keywords>
            </t>

            <t t-snippet="fikra_blocks.s_fikra_linkcards"
               string="Cartes-liens"
               group="columns">
                <keywords>cartes, liens, services, grille, survol, hover, portfolio, rubriques</keywords>
            </t>

            <t t-snippet="fikra_blocks.s_fikra_logos"
               string="Défilement d'images"
               group="images">
                <keywords>logos, partenaires, references, defilement, carrousel, bande, images</keywords>
            </t>

            <t t-snippet="fikra_blocks.s_fikra_marquee"
               string="Bandeau défilant"
               group="content">
                <keywords>bandeau, marquee, defilant, texte, ticker, logos</keywords>
            </t>

            <t t-snippet="fikra_blocks.s_fikra_cards"
               string="Cartes animées"
               group="columns">
                <keywords>cartes, cards, services, avantages, survol, hover, colonnes</keywords>
            </t>

            <t t-snippet="fikra_blocks.s_fikra_pricing"
               string="Grille tarifaire"
               group="columns">
                <keywords>tarifs, prix, pricing, offres, forfaits, abonnement, plans</keywords>
            </t>

        </xpath>

    </template>

</odoo>