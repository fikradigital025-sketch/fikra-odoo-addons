<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================================
         Bandeau défilant — options
         ==================================================================== -->
    <template id="s_fikra_marquee_options" inherit_id="website.snippet_options"
              name="Bandeau défilant — options">

        <xpath expr="." position="inside">
            <div data-js="FikraMarquee"
                 data-selector=".s_fikra_marquee"
                 string="Bandeau défilant">

                <we-select string="Vitesse">
                    <we-button data-select-class="s_fikra_marquee_slow">Lente</we-button>
                    <we-button data-select-class="">Normale</we-button>
                    <we-button data-select-class="s_fikra_marquee_fast">Rapide</we-button>
                </we-select>

                <we-select string="Sens">
                    <we-button data-select-class="">Vers la gauche</we-button>
                    <we-button data-select-class="s_fikra_marquee_reverse">Vers la droite</we-button>
                </we-select>

                <we-select string="Style">
                    <we-button data-select-class="">Plein</we-button>
                    <we-button data-select-class="s_fikra_marquee_outline">Contour</we-button>
                </we-select>

                <we-checkbox string="Pause au survol"
                             data-select-class="s_fikra_marquee_pause"/>

            </div>
        </xpath>

    </template>

    <!-- ====================================================================
         Cartes animées — options
         ==================================================================== -->
    <template id="s_fikra_cards_options" inherit_id="website.snippet_options"
              name="Cartes animées — options">

        <xpath expr="." position="inside">
            <div data-js="FikraCards"
                 data-selector=".s_fikra_cards"
                 string="Cartes animées">

                <we-select string="Effet de survol">
                    <we-button data-select-class="">Élévation</we-button>
                    <we-button data-select-class="s_fikra_cards_glow">Bordure lumineuse</we-button>
                    <we-button data-select-class="s_fikra_cards_zoom">Zoom de l'icône</we-button>
                    <we-button data-select-class="s_fikra_cards_static">Aucun</we-button>
                </we-select>

                <we-select string="Style de carte">
                    <we-button data-select-class="">Fond léger</we-button>
                    <we-button data-select-class="s_fikra_cards_bordered">Contour</we-button>
                    <we-button data-select-class="s_fikra_cards_flat">Sans bordure</we-button>
                </we-select>

                <we-select string="Angles">
                    <we-button data-select-class="">Arrondis</we-button>
                    <we-button data-select-class="s_fikra_cards_sharp">Droits</we-button>
                </we-select>

            </div>
        </xpath>

    </template>

    <!-- ====================================================================
         Grille tarifaire — options
         ==================================================================== -->
    <template id="s_fikra_pricing_options" inherit_id="website.snippet_options"
              name="Grille tarifaire — options">

        <xpath expr="." position="inside">
            <div data-js="FikraPricing"
                 data-selector=".s_fikra_pricing"
                 string="Grille tarifaire">

                <we-select string="Fond des cartes">
                    <we-button data-select-class="">Léger</we-button>
                    <we-button data-select-class="s_fikra_pricing_flat">Transparent</we-button>
                </we-select>

                <we-select string="Angles">
                    <we-button data-select-class="">Arrondis</we-button>
                    <we-button data-select-class="s_fikra_pricing_sharp">Droits</we-button>
                </we-select>

                <we-select string="Offre recommandée">
                    <we-button data-select-class="">Agrandie</we-button>
                    <we-button data-select-class="s_fikra_pricing_nolift">Même taille</we-button>
                </we-select>

                <we-checkbox string="Effet au survol"
                             data-select-class="s_fikra_pricing_hover"/>

            </div>
        </xpath>

    </template>

    <!-- ====================================================================
         Défilement d'images — options
         ==================================================================== -->
    <template id="s_fikra_logos_options" inherit_id="website.snippet_options"
              name="Défilement d'images — options">

        <xpath expr="." position="inside">
            <div data-js="FikraLogos"
                 data-selector=".s_fikra_logos"
                 string="Défilement d'images">

                <we-select string="Vitesse">
                    <we-button data-select-class="s_fikra_logos_slow">Lente</we-button>
                    <we-button data-select-class="">Normale</we-button>
                    <we-button data-select-class="s_fikra_logos_fast">Rapide</we-button>
                </we-select>

                <we-select string="Sens">
                    <we-button data-select-class="">Vers la gauche</we-button>
                    <we-button data-select-class="s_fikra_logos_reverse">Vers la droite</we-button>
                </we-select>

                <we-select string="Taille des images">
                    <we-button data-select-class="s_fikra_logos_sm">Petite</we-button>
                    <we-button data-select-class="">Moyenne</we-button>
                    <we-button data-select-class="s_fikra_logos_lg">Grande</we-button>
                </we-select>

                <we-select string="Rendu">
                    <we-button data-select-class="">Couleur d'origine</we-button>
                    <we-button data-select-class="s_fikra_logos_gray">Gris, couleur au survol</we-button>
                    <we-button data-select-class="s_fikra_logos_rounded">Vignettes arrondies</we-button>
                </we-select>

                <we-checkbox string="Pause au survol"
                             data-select-class="s_fikra_logos_pause"/>

            </div>
        </xpath>

    </template>

    <!-- ====================================================================
         Compteurs animés — options
         ==================================================================== -->
    <template id="s_fikra_counter_options" inherit_id="website.snippet_options"
              name="Compteurs animés — options">

        <xpath expr="." position="inside">
            <div data-js="FikraCounterOptions"
                 data-selector=".s_fikra_counter"
                 string="Compteurs animés">

                <we-select string="Présentation">
                    <we-button data-select-class="">Simple</we-button>
                    <we-button data-select-class="s_fikra_counter_boxed">Encadrée</we-button>
                    <we-button data-select-class="s_fikra_counter_divided">Séparateurs</we-button>
                </we-select>

                <we-checkbox string="Masquer les icônes"
                             data-select-class="s_fikra_counter_noicon"/>

            </div>
        </xpath>

    </template>

    <!-- ====================================================================
         Cartes-liens — options
         ==================================================================== -->
    <template id="s_fikra_linkcards_options" inherit_id="website.snippet_options"
              name="Cartes-liens — options">

        <xpath expr="." position="inside">
            <div data-js="FikraLinkcards"
                 data-selector=".s_fikra_linkcards"
                 string="Cartes-liens">

                <we-select string="Format">
                    <we-button data-select-class="">Paysage</we-button>
                    <we-button data-select-class="s_fikra_linkcards_square">Carré</we-button>
                    <we-button data-select-class="s_fikra_linkcards_tall">Portrait</we-button>
                </we-select>

                <we-select string="Assombrissement">
                    <we-button data-select-class="">Dégradé</we-button>
                    <we-button data-select-class="s_fikra_linkcards_light">Dégradé léger</we-button>
                    <we-button data-select-class="s_fikra_linkcards_solid">Uniforme</we-button>
                </we-select>

                <we-select string="Angles">
                    <we-button data-select-class="">Arrondis</we-button>
                    <we-button data-select-class="s_fikra_linkcards_sharp">Droits</we-button>
                </we-select>

            </div>
        </xpath>

    </template>

</odoo>