<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================================
         Bandeau défilant — options
         ==================================================================== -->
    <template id="s_fikra_marquee_options" inherit_id="website.snippet_options"
              name="Bandeau défilant — options">

        <xpath expr="." position="inside">
            <div data-js="FikraMarquee"
                 data-selector=".s_fikra_marquee"
                 string="Bandeau défilant">

                <we-select string="Vitesse">
                    <we-button data-select-class="s_fikra_marquee_slow">Lente</we-button>
                    <we-button data-select-class="">Normale</we-button>
                    <we-button data-select-class="s_fikra_marquee_fast">Rapide</we-button>
                </we-select>

                <we-select string="Sens">
                    <we-button data-select-class="">Vers la gauche</we-button>
                    <we-button data-select-class="s_fikra_marquee_reverse">Vers la droite</we-button>
                </we-select>

                <we-select string="Style">
                    <we-button data-select-class="">Plein</we-button>
                    <we-button data-select-class="s_fikra_marquee_outline">Contour</we-button>
                </we-select>

                <we-checkbox string="Pause au survol"
                             data-select-class="s_fikra_marquee_pause"/>

            </div>
        </xpath>

    </template>

    <!-- ====================================================================
         Cartes animées — options
         Chaque réglage se traduit par une classe CSS : aucun JavaScript.
         ==================================================================== -->
    <template id="s_fikra_cards_options" inherit_id="website.snippet_options"
              name="Cartes animées — options">

        <xpath expr="." position="inside">
            <div data-js="FikraCards"
                 data-selector=".s_fikra_cards"
                 string="Cartes animées">

                <we-select string="Effet de survol">
                    <we-button data-select-class="">Élévation</we-button>
                    <we-button data-select-class="s_fikra_cards_glow">Bordure lumineuse</we-button>
                    <we-button data-select-class="s_fikra_cards_zoom">Zoom de l'icône</we-button>
                    <we-button data-select-class="s_fikra_cards_static">Aucun</we-button>
                </we-select>

                <we-select string="Style de carte">
                    <we-button data-select-class="">Fond léger</we-button>
                    <we-button data-select-class="s_fikra_cards_bordered">Contour</we-button>
                    <we-button data-select-class="s_fikra_cards_flat">Sans bordure</we-button>
                </we-select>

                <we-select string="Angles">
                    <we-button data-select-class="">Arrondis</we-button>
                    <we-button data-select-class="s_fikra_cards_sharp">Droits</we-button>
                </we-select>

            </div>
        </xpath>

    </template>

</odoo>